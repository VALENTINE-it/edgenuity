<div class="dashboard">
  <!-- Sidebar -->
  <aside>
    <a href="/" style="text-decoration: none;">
      <%= logo %>
    </a>

    <nav>
      <a class="active" href="/dashboard">
        <%= icon(:home) %> Overview
      </a>
      <a href="#dashboard-mentors">
        <%= icon(:users) %> Find mentors
      </a>
      <a href="#session">
        <%= icon(:calendar) %> My sessions
      </a>
      <a href="#messages" onclick="alert('You have 2 new messages from Dr. Lena Ortiz regarding your calculus assignment!')">
        <%= icon(:message) %> Messages <b>2</b>
      </a>
    </nav>

    <div class="aside-help">
      <span><%= icon(:spark) %></span>
      <h4>Need quick help?</h4>
      <p>Tell us what you're working on and we'll find the right mentor.</p>
      <% first_mentor = @mentors.first %>
      <button type="button" onclick="openBookingModal('<%= first_mentor.id %>', '<%= first_mentor.name %>', '<%= first_mentor.role %>', '<%= first_mentor.rating %>', '<%= first_mentor.image %>')">
        Get matched
      </button>
    </div>

    <a class="logout" href="/logout" style="text-align: center; text-decoration: none; display: block;">Log out</a>
  </aside>

  <!-- Main Content -->
  <main class="dashboard-main">
    <header>
      <div>
        <p><%= Time.now.strftime("%A, %B %d") %></p>
        <h1>Good morning, Maya!</h1>
      </div>
      <div class="student">
        <button aria-label="Search" type="button" onclick="document.getElementById('dashboard-mentors').scrollIntoView({behavior: 'smooth'})">
          <%= icon(:search) %>
        </button>
        <span class="notification">3</span>
        <img src="https://images.unsplash.com/photo-1717509321467-d7ab4aa02abd?auto=format&fit=crop&w=120&q=80" alt="Maya's profile">
        <div>
          <strong>Maya</strong>
          <small>Student</small>
        </div>
      </div>
    </header>

    <!-- Welcome Hero Banner -->
    <section class="welcome-card">
      <div>
        <span class="mini-eyebrow">
          <%= icon(:spark, size: 16) %> You're making great progress
        </span>
        <h2>What can we help you<br>understand today?</h2>
        <p>Get unstuck with one-on-one guidance from a mentor who gets it.</p>
        <button type="button" onclick="openBookingModal('<%= first_mentor.id %>', '<%= first_mentor.name %>', '<%= first_mentor.role %>', '<%= first_mentor.rating %>', '<%= first_mentor.image %>')">
          Find a mentor <%= icon(:arrow, size: 18) %>
        </button>
      </div>
      <div class="welcome-art">
        <div class="orbit o1"></div>
        <div class="orbit o2"></div>
        <%= icon(:book, size: 72) %>
      </div>
    </section>

    <!-- Columns: Left = Mentors for you, Right = Upcoming & Stats -->
    <div class="dashboard-columns">
      <!-- Mentors List -->
      <section class="recommend" id="dashboard-mentors">
        <div class="dash-section-head">
          <div>
            <h2>Mentors for you</h2>
            <p>Based on the subjects you’re studying</p>
          </div>
          <button type="button" onclick="alert('Showing all <%= @mentors.count %> verified mentors available this week')">
            View all <%= icon(:arrow, size: 16) %>
          </button>
        </div>

        <div class="dash-mentor-list">
          <% @mentors.each do |mentor| %>
            <article>
              <img src="<%= mentor.image %>" alt="<%= mentor.name %>">
              <div class="dash-mentor-main">
                <h3><%= mentor.name %></h3>
                <p><%= mentor.role %></p>
                <span>
                  <%= icon(:star, size: 13) %> <%= mentor.rating %> <i>•</i> <%= mentor.sessions_count %>
                </span>
              </div>
              <div class="dash-tags">
                <% mentor.tags_array.each do |tag| %>
                  <span><%= tag %></span>
                <% end %>
              </div>
              <button type="button" onclick="openBookingModal('<%= mentor.id %>', '<%= mentor.name %>', '<%= mentor.role %>', '<%= mentor.rating %>', '<%= mentor.image %>')">
                Book session
              </button>
            </article>
          <% end %>
        </div>
      </section>

      <!-- Right Column -->
      <section class="right-column">
        <!-- Upcoming Session Card -->
        <div class="upcoming" id="session">
          <div class="dash-section-head">
            <div>
              <h2>Upcoming session</h2>
              <p>Your next one-on-one</p>
            </div>
            <%= icon(:calendar) %>
          </div>

          <% upcoming = @upcoming_session || MentoringSession.first %>
          <% if upcoming %>
            <div class="session-date">
              <b><%= upcoming.session_date.strftime("%d") %></b>
              <span>
                <%= upcoming.session_date.strftime("%^b") %>
                <small><%= upcoming.session_date.strftime("%A") %></small>
              </span>
            </div>

            <div class="session-subject">
              <span><%= upcoming.subject %></span>
              <h3><%= upcoming.topic %></h3>
            </div>

            <div class="session-mentor">
              <img src="<%= upcoming.mentor.image %>" alt="<%= upcoming.mentor.name %>">
              <div>
                <strong><%= upcoming.mentor.name %></strong>
                <small><%= upcoming.start_time %>–<%= upcoming.end_time %></small>
              </div>
              <button type="button" aria-label="Message mentor" onclick="alert('Opening direct chat with <%= upcoming.mentor.name %>...')">
                <%= icon(:message, size: 18) %>
              </button>
            </div>

            <button class="join-button" type="button" onclick="alert('Joining secure video room with <%= upcoming.mentor.name %>...')">
              <%= icon(:video, size: 17) %> Join session
            </button>
          <% else %>
            <p style="padding: 20px 0; color: #6b7280; font-size: 14px;">No upcoming sessions scheduled yet.</p>
          <% end %>
        </div>

        <!-- Weekly Progress Card -->
        <div class="progress-card">
          <div>
            <span><%= icon(:clock) %></span>
            <strong>4.5 hrs</strong>
            <small>Learning time this week</small>
          </div>
          <div>
            <b>+18%</b> from last week
          </div>
        </div>
      </section>
    </div>
  </main>
</div>

<!-- Booking Modal Backdrop -->
<div class="modal-backdrop modal-hidden" id="booking-modal-backdrop" role="presentation" onclick="if(event.target === this) closeBookingModal()">
  <div class="booking-modal" role="dialog" aria-modal="true" aria-labelledby="booking-title">
    <button class="modal-close" aria-label="Close booking" type="button" onclick="closeBookingModal()">
      <%= icon(:close) %>
    </button>

    <div id="booking-form-step">
      <span class="modal-label">Book a session</span>
      <h2 id="booking-title">Choose a time with <span id="booking-modal-title-name">Dr. Lena Ortiz</span></h2>

      <div class="booking-mentor">
        <img id="booking-mentor-img" src="<%= first_mentor.image %>" alt="">
        <div>
          <strong id="booking-mentor-name"><%= first_mentor.name %></strong>
          <p id="booking-mentor-role"><%= first_mentor.role %> · ★ <%= first_mentor.rating %></p>
        </div>
      </div>

      <form action="/bookings" method="post" id="booking-form">
        <input type="hidden" name="mentor_id" id="booking-mentor-id" value="<%= first_mentor.id %>">
        <input type="hidden" name="selected_time" id="selected-time-slot" value="Fri, 2:00 PM">

        <label style="display: block; font-weight: 600; font-size: 13px; margin-bottom: 8px;">
          What do you need help with?
          <select name="help_type" style="width: 100%; margin-top: 6px; padding: 10px 14px; border: 1px solid var(--bs-gray-300); border-radius: 8px; font-size: 13px;">
            <option value="Assignment review">Assignment review</option>
            <option value="Exam preparation">Exam preparation</option>
            <option value="Understanding a concept">Understanding a concept</option>
          </select>
        </label>

        <div class="time-grid">
          <button type="button" class="selected" onclick="selectTimeSlot(this, 'Fri, 2:00 PM')">Fri, 2:00 PM</button>
          <button type="button" onclick="selectTimeSlot(this, 'Fri, 4:30 PM')">Fri, 4:30 PM</button>
          <button type="button" onclick="selectTimeSlot(this, 'Sat, 10:00 AM')">Sat, 10:00 AM</button>
        </div>

        <button class="primary-button confirm" type="submit">
          Confirm session <%= icon(:arrow, size: 18) %>
        </button>
      </form>
    </div>
  </div>
</div>
