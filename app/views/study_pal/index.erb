<div class="site-shell">
  <header class="topbar">
    <a href="/" aria-label="Edgenuity home">
      <%= logo %>
    </a>

    <nav class="nav-links" id="topbar-nav" aria-label="Main navigation">
      <a href="#how">How it works</a>
      <a href="#mentors">Find a mentor</a>
      <a href="#subjects">Subjects</a>
    </nav>

    <div class="nav-actions">
      <button class="text-button" type="button" onclick="openLoginModal('login')">Log in</button>
      <button class="primary-button small" type="button" onclick="openLoginModal('signup')">
        Get started <%= icon(:arrow, size: 17) %>
      </button>
      <button class="menu-button" aria-label="Toggle menu" type="button" onclick="toggleMobileMenu()">
        <%= icon(:menu) %>
      </button>
    </div>
  </header>

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-copy">
        <div class="eyebrow">
          <%= icon(:spark, size: 17) %> Learn better, together
        </div>
        <h1>Assignment help that finally <em>makes sense.</em></h1>
        <p>Connect one-on-one with friendly, verified mentors who guide you through the hard parts—so you can learn with confidence.</p>
        
        <div class="hero-actions">
          <button class="primary-button" type="button" onclick="openLoginModal('signup')">
            Find your mentor <%= icon(:arrow, size: 19) %>
          </button>
          <a class="secondary-button" href="#how">
            <span class="play"><%= icon(:video, size: 17) %></span> See how it works
          </a>
        </div>

        <div class="social-proof">
          <div class="proof-avatars">
            <% @mentors.each do |mentor| %>
              <img src="<%= mentor.image %>" alt="<%= mentor.name %>">
            <% end %>
            <span>+2k</span>
          </div>
          <div>
            <div class="stars">★★★★★</div>
            <p>Trusted by 8,000+ students</p>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="shape shape-one"></div>
        <div class="shape shape-two"></div>
        <div class="hero-photo">
          <img src="https://images.unsplash.com/photo-1758270704524-596810e891b5?auto=format&fit=crop&w=1100&q=85" alt="Students learning together in a lecture hall">
          <div class="session-card">
            <div class="session-icon">
              <%= icon(:video, size: 20) %>
            </div>
            <div>
              <strong>Live mentor support</strong>
              <span>Available when you need it</span>
            </div>
            <span class="online-dot"></span>
          </div>

          <div class="floating-card">
            <span class="badge"><%= icon(:check, size: 15) %> Assignment solved</span>
            <p>Calculus III — Taylor Series</p>
            <div class="progress-wrap">
              <div class="progress-bar" style="width: 100%;"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Subjects Categories Section -->
    <section class="subjects-section" id="subjects">
      <div class="section-heading">
        <span class="eyebrow"><%= icon(:book, size: 17) %> Personalized Learning</span>
        <h2>Explore subjects where you need a boost</h2>
      </div>

      <div class="subjects-grid">
        <div class="subject-card">
          <span class="subject-icon math">∑</span>
          <h3>Mathematics</h3>
          <p>Algebra, Pre-Calculus, AP Calculus AB/BC, Differential Equations & Linear Algebra.</p>
          <button type="button" class="subject-link" onclick="openLoginModal('signup')">Find Math Mentors →</button>
        </div>

        <div class="subject-card">
          <span class="subject-icon cs">&lt;/&gt;</span>
          <h3>Computer Science</h3>
          <p>Python, Algorithms, Data Structures, Web Development, Object-Oriented Java & C++.</p>
          <button type="button" class="subject-link" onclick="openLoginModal('signup')">Find CS Mentors →</button>
        </div>

        <div class="subject-card">
          <span class="subject-icon physics">⚛</span>
          <h3>Physics & Engineering</h3>
          <p>Kinematics, Thermodynamics, Electricity & Magnetism, Quantum Physics & Statics.</p>
          <button type="button" class="subject-link" onclick="openLoginModal('signup')">Find Physics Mentors →</button>
        </div>

        <div class="subject-card">
          <span class="subject-icon chemistry">⚗</span>
          <h3>Chemistry & Biology</h3>
          <p>Organic Chemistry synthesis, Biochemistry, Cellular Biology & Laboratory reports.</p>
          <button type="button" class="subject-link" onclick="openLoginModal('signup')">Find Science Mentors →</button>
        </div>
      </div>
    </section>

    <!-- 3-Step Learning Workflow Section -->
    <section class="steps-section" id="how">
      <div class="section-heading centered">
        <span class="eyebrow"><%= icon(:spark, size: 17) %> Simple 3-step workflow</span>
        <h2>From stuck to confident in three steps</h2>
        <p>No more staring at confusing problem sets alone. Getting help is fast, safe, and personalized.</p>
      </div>

      <div class="steps-grid">
        <article class="step-card">
          <div class="step-badge">1</div>
          <div class="step-icon">
            <%= icon(:search, size: 28) %>
          </div>
          <h3>Tell us what you're stuck on</h3>
          <p>Select your subject and assignment topic. Upload problem screenshots or paste problem questions.</p>
        </article>

        <article class="step-card active">
          <div class="step-badge">2</div>
          <div class="step-icon">
            <%= icon(:users, size: 28) %>
          </div>
          <h3>Match with a verified mentor</h3>
          <p>Browse top-rated university peer mentors who have mastered your exact curriculum and book a slot.</p>
        </article>

        <article class="step-card">
          <div class="step-badge">3</div>
          <div class="step-icon">
            <%= icon(:video, size: 28) %>
          </div>
          <h3>Learn 1-on-1 with live support</h3>
          <p>Hop into an interactive 1-on-1 audio/video room with whiteboard sharing, step-by-step guidance, and notes.</p>
        </article>
      </div>
    </section>

    <!-- Verified Mentors Showcase Section -->
    <section class="mentors-section" id="mentors">
      <div class="section-heading row">
        <div>
          <span class="eyebrow"><%= icon(:star, size: 17) %> Top rated educators</span>
          <h2>Meet a few of our verified mentors</h2>
          <p>Every mentor undergoes strict subject proficiency vetting and background checks.</p>
        </div>
        <button class="primary-button small" type="button" onclick="openLoginModal('signup')">
          Browse all mentors <%= icon(:arrow, size: 17) %>
        </button>
      </div>

      <div class="mentor-grid">
        <% @mentors.each do |mentor| %>
          <article class="mentor-card">
            <div class="mentor-photo" style="background-color: <%= mentor.color %>;">
              <img src="<%= mentor.image %>" alt="<%= mentor.name %>">
              <span class="verified-pill"><%= icon(:check, size: 13) %> Verified</span>
            </div>
            <div class="mentor-body">
              <div class="mentor-header">
                <div>
                  <h3><%= mentor.name %></h3>
                  <p><%= mentor.role %></p>
                </div>
                <div class="rating">
                  ★ <%= mentor.rating %>
                </div>
              </div>

              <div class="tags">
                <% mentor.tags_array.each do |tag| %>
                  <span><%= tag %></span>
                <% end %>
              </div>

              <div class="mentor-footer">
                <span><%= mentor.sessions_count %></span>
                <button type="button" class="book-btn" onclick="openLoginModal('signup')">
                  Book session <%= icon(:arrow, size: 15) %>
                </button>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta">
      <div>
        <span><%= icon(:spark, size: 18) %> Your next breakthrough is closer than you think</span>
        <h2>Ready to stop stressing and start understanding?</h2>
      </div>
      <button class="light-button" type="button" onclick="openLoginModal('signup')">
        Meet your mentor <%= icon(:arrow, size: 18) %>
      </button>
    </section>
  </main>

  <footer>
    <%= logo %>
    <p>Real people. Real learning. Real progress.</p>
    <div style="display: flex; gap: 18px; align-items: center; flex-wrap: wrap;">
      <button type="button" onclick="openCookiePreferencesModal()" style="background: none; border: none; color: #475569; cursor: pointer; text-decoration: underline; font-size: 13px;">Cookie & Privacy Preferences</button>
      <span style="color: #94a3b8; font-size: 13px;">© 2026 Edgenuity</span>
    </div>
  </footer>
</div>

<!-- Dual-Tab Auth (Login / Signup) Modal -->
<div class="modal-backdrop modal-hidden" id="login-modal-backdrop" role="presentation" onclick="if(event.target === this) closeLoginModal()">
  <div class="login-modal" role="dialog" aria-modal="true" aria-labelledby="auth-modal-title">
    <button class="modal-close" aria-label="Close login" type="button" onclick="closeLoginModal()">
      <%= icon(:close) %>
    </button>
    <%= logo %>

    <!-- Tabs switcher -->
    <div style="display: flex; border-bottom: 2px solid #e2e8f0; margin: 18px 0 20px;">
      <button type="button" id="auth-tab-login" onclick="switchAuthTab('login')" style="flex: 1; padding: 10px; background: none; border: none; border-bottom: 2px solid #00007c; font-weight: 700; font-size: 14px; color: #00007c; cursor: pointer; margin-bottom: -2px;">
        Log In
      </button>
      <button type="button" id="auth-tab-signup" onclick="switchAuthTab('signup')" style="flex: 1; padding: 10px; background: none; border: none; border-bottom: 2px solid transparent; font-weight: 700; font-size: 14px; color: #64748b; cursor: pointer; margin-bottom: -2px;">
        Create Account
      </button>
    </div>

    <!-- Login Section -->
    <div id="auth-login-section">
      <div class="modal-heading">
        <h2 id="auth-modal-title" style="font-size: 20px; font-weight: 800; color: #0f172a; margin-bottom: 4px;">Welcome back!</h2>
        <p style="font-size: 13px; color: #64748b; margin: 0;">Log in to connect with your mentors and access your sessions.</p>
      </div>

      <form action="/login" method="post" style="margin-top: 16px;">
        <label style="display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 12px;">
          Email address
          <input required type="email" name="email" placeholder="you@school.edu" style="width: 100%; margin-top: 6px; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" autofocus>
        </label>

        <label style="display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 16px;">
          Password
          <input required type="password" name="password" placeholder="Enter your password" minlength="6" style="width: 100%; margin-top: 6px; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;">
        </label>

        <button class="primary-button login-submit" type="submit" style="width: 100%; justify-content: center;">
          Log in to Edgenuity <%= icon(:arrow, size: 18) %>
        </button>
      </form>

      <p class="signup-copy" style="text-align: center; margin-top: 16px; font-size: 13px; color: #64748b;">
        Don't have an account yet? <a href="javascript:void(0)" onclick="switchAuthTab('signup')" style="color: #00007c; font-weight: 700;">Create an account</a>
      </p>
    </div>

    <!-- Signup Section -->
    <div id="auth-signup-section" style="display: none;">
      <div class="modal-heading">
        <h2 style="font-size: 20px; font-weight: 800; color: #0f172a; margin-bottom: 4px;">Join Edgenuity</h2>
        <p style="font-size: 13px; color: #64748b; margin: 0;">Create your student account to get matched with top mentors.</p>
      </div>

      <form action="/signup" method="post" style="margin-top: 16px;">
        <label style="display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 12px;">
          Full Name
          <input required type="text" name="name" placeholder="e.g. Alex Rivera" style="width: 100%; margin-top: 6px; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;">
        </label>

        <label style="display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 12px;">
          Email address
          <input required type="email" name="email" placeholder="you@school.edu" style="width: 100%; margin-top: 6px; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;">
        </label>

        <label style="display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 12px;">
          Create a Password (min 8 characters)
          <input required type="password" name="password" minlength="8" placeholder="At least 8 characters" style="width: 100%; margin-top: 6px; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;">
        </label>

        <label style="display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 16px;">
          Confirm Password
          <input required type="password" name="password_confirmation" minlength="8" placeholder="Confirm your password" style="width: 100%; margin-top: 6px; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;">
        </label>

        <button class="primary-button login-submit" type="submit" style="width: 100%; justify-content: center;">
          Create Student Account <%= icon(:arrow, size: 18) %>
        </button>
      </form>

      <p class="signup-copy" style="text-align: center; margin-top: 16px; font-size: 13px; color: #64748b;">
        Already have an account? <a href="javascript:void(0)" onclick="switchAuthTab('login')" style="color: #00007c; font-weight: 700;">Log in</a>
      </p>
    </div>
  </div>
</div>
