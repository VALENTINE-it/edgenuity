<div class="site-shell">
  <header class="topbar">
    <a href="/" aria-label="Edgenuity home">
      <%= logo %>
    </a>

    <nav class="nav-links" id="topbar-nav" aria-label="Main navigation">
      <a href="#how">How it works</a>
      <a href="#mentors">Find a mentor</a>
      <a href="#subjects">Subjects</a>
    </nav>

    <div class="nav-actions">
      <button class="text-button" type="button" onclick="openLoginModal()">Log in</button>
      <button class="primary-button small" type="button" onclick="openLoginModal()">
        Get started <%= icon(:arrow, size: 17) %>
      </button>
      <button class="menu-button" aria-label="Toggle menu" type="button" onclick="toggleMobileMenu()">
        <%= icon(:menu) %>
      </button>
    </div>
  </header>

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-copy">
        <div class="eyebrow">
          <%= icon(:spark, size: 17) %> Learn better, together
        </div>
        <h1>Assignment help that finally <em>makes sense.</em></h1>
        <p>Connect one-on-one with friendly, verified mentors who guide you through the hard parts—so you can learn with confidence.</p>
        
        <div class="hero-actions">
          <button class="primary-button" type="button" onclick="openLoginModal()">
            Find your mentor <%= icon(:arrow, size: 19) %>
          </button>
          <a class="secondary-button" href="#how">
            <span class="play"><%= icon(:video, size: 17) %></span> See how it works
          </a>
        </div>

        <div class="social-proof">
          <div class="proof-avatars">
            <% @mentors.each do |mentor| %>
              <img src="<%= mentor.image %>" alt="<%= mentor.name %>">
            <% end %>
            <span>+2k</span>
          </div>
          <div>
            <div class="stars">★★★★★</div>
            <p>Trusted by 8,000+ students</p>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="shape shape-one"></div>
        <div class="shape shape-two"></div>
        <div class="hero-photo">
          <img src="https://images.unsplash.com/photo-1758270704524-596810e891b5?auto=format&fit=crop&w=1100&q=85" alt="Students learning together in a lecture hall">
          <div class="session-card">
            <div class="session-icon">
              <%= icon(:video, size: 20) %>
            </div>
            <div>
              <strong>Live mentor support</strong>
              <span>Available when you need it</span>
            </div>
            <span class="online-dot"></span>
          </div>
        </div>

        <div class="floating-card">
          <span class="float-icon"><%= icon(:check, size: 19) %></span>
          <div>
            <strong>Assignment solved!</strong>
            <small>You nailed quadratic equations</small>
          </div>
        </div>
      </div>
    </section>

    <!-- Subjects Strip -->
    <section class="subject-strip" id="subjects">
      <span>Get help with</span>
      <% [
        ["Mathematics", :book, 0],
        ["Computer science", :spark, 1],
        ["Physics", :book, 2],
        ["Chemistry", :book, 3],
        ["Writing", :book, 4]
      ].each do |subj, icon_name, idx| %>
        <button type="button" onclick="openLoginModal()">
          <i class="subject-icon s<%= idx %>"><%= icon(icon_name, size: 16) %></i>
          <%= subj %>
        </button>
      <% end %>
    </section>

    <!-- Steps Section -->
    <section class="steps-section" id="how">
      <div class="section-heading">
        <span>Simple and supportive</span>
        <h2>From stuck to confident in three steps</h2>
        <p>No judgment. No confusing explanations. Just the right help, right when you need it.</p>
      </div>

      <div class="steps-grid">
        <article class="step-card">
          <div class="step-top">
            <span class="step-icon"><%= icon(:message, size: 22) %></span>
            <b>01</b>
          </div>
          <h3>Tell us what you need</h3>
          <p>Share your subject, assignment, and when you would like to meet.</p>
        </article>

        <article class="step-card">
          <div class="step-top">
            <span class="step-icon"><%= icon(:users, size: 22) %></span>
            <b>02</b>
          </div>
          <h3>Match with a mentor</h3>
          <p>Browse verified experts and choose someone who fits your learning style.</p>
        </article>

        <article class="step-card">
          <div class="step-top">
            <span class="step-icon"><%= icon(:video, size: 22) %></span>
            <b>03</b>
          </div>
          <h3>Learn it together</h3>
          <p>Meet live, work through the problem, and leave understanding the “why.”</p>
        </article>
      </div>
    </section>

    <!-- Mentors Section -->
    <section class="mentors-section" id="mentors">
      <div class="section-heading row">
        <div>
          <span>Meet your study team</span>
          <h2>Mentors students love learning with</h2>
        </div>
        <button class="secondary-button" type="button" onclick="openLoginModal()">
          View all mentors <%= icon(:arrow, size: 18) %>
        </button>
      </div>

      <div class="mentor-grid">
        <% @mentors.each do |mentor| %>
          <article class="mentor-card">
            <div class="mentor-photo" style="background-color: <%= mentor.color %>;">
              <img src="<%= mentor.image %>" alt="<%= mentor.name %>, <%= mentor.role %> mentor">
              <span class="available">Available</span>
            </div>
            <div class="mentor-info">
              <div class="mentor-name">
                <div>
                  <h3><%= mentor.name %></h3>
                  <p><%= mentor.role %></p>
                </div>
                <span><%= icon(:star, size: 15) %> <%= mentor.rating %></span>
              </div>
              <div class="tags">
                <% mentor.tags_array.each do |tag| %>
                  <span><%= tag %></span>
                <% end %>
              </div>
              <div class="mentor-foot">
                <span><%= icon(:video, size: 16) %> <%= mentor.sessions_count %></span>
                <button type="button" onclick="openLoginModal()">View profile</button>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta">
      <div>
        <span><%= icon(:spark, size: 18) %> Your next breakthrough is closer than you think</span>
        <h2>Ready to stop stressing and start understanding?</h2>
      </div>
      <button class="light-button" type="button" onclick="openLoginModal()">
        Meet your mentor <%= icon(:arrow, size: 18) %>
      </button>
    </section>
  </main>

  <footer>
    <%= logo %>
    <p>Real people. Real learning. Real progress.</p>
    <span>© 2026 Edgenuity</span>
  </footer>
</div>

<!-- Login / Signup Modal -->
<div class="modal-backdrop modal-hidden" id="login-modal-backdrop" role="presentation" onclick="if(event.target === this) closeLoginModal()">
  <div class="login-modal" role="dialog" aria-modal="true" aria-labelledby="login-title">
    <button class="modal-close" aria-label="Close login" type="button" onclick="closeLoginModal()">
      <%= icon(:close) %>
    </button>
    <%= logo %>
    <div class="modal-heading">
      <span>Welcome back</span>
      <h2 id="login-title">Ready to keep learning?</h2>
      <p>Log in to connect with your mentors and get help with your assignments.</p>
    </div>

    <form action="/login" method="post" style="display: block; width: 100%;">
      <button class="google-button" type="submit" name="provider" value="google">
        <b>G</b> Continue with Google
      </button>
    </form>

    <div class="divider">
      <span>or continue with email</span>
    </div>

    <form action="/login" method="post">
      <label>
        Email address
        <input required type="email" name="email" placeholder="you@school.edu" value="maya@school.edu" autofocus>
      </label>

      <label>
        Password
        <span class="label-row">
          <span></span>
          <button type="button" style="font-size: 11px; color: var(--bs-indigo); cursor: pointer;">Forgot password?</button>
        </span>
        <input required type="password" name="password" placeholder="Enter your password" minlength="6" value="password123">
      </label>

      <button class="primary-button login-submit" type="submit">
        Log in to Edgenuity <%= icon(:arrow, size: 18) %>
      </button>
    </form>

    <p class="signup-copy">
      New to Edgenuity? <a href="/dashboard" style="color: var(--bs-indigo); font-weight: 700;">Enter as Guest Student (Maya)</a>
    </p>
  </div>
</div>
